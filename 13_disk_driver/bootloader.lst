     1                                  ; bootloader.asm - 引导程序
     2                                  
     3                                  [BITS 16]
     4                                  [ORG 0x7C00]
     5                                  
     6                                  KERNEL_START   equ 0x7E00
     7                                  KERNEL_SECTORS equ 4
     8                                  
     9                                  start:
    10 00000000 FA                          cli
    11 00000001 31C0                        xor ax, ax
    12 00000003 8ED8                        mov ds, ax
    13 00000005 8EC0                        mov es, ax
    14 00000007 8ED0                        mov ss, ax
    15 00000009 BC007C                      mov sp, 0x7C00
    16                                  
    17 0000000C BE[5A00]                    mov si, msg_load
    18 0000000F E83300                      call print16
    19                                  
    20 00000012 B402                        mov ah, 0x02
    21 00000014 B004                        mov al, KERNEL_SECTORS
    22 00000016 B500                        mov ch, 0
    23 00000018 B102                        mov cl, 2
    24 0000001A B600                        mov dh, 0
    25 0000001C B200                        mov dl, 0x00
    26 0000001E BB007E                      mov bx, KERNEL_START
    27 00000021 CD13                        int 0x13
    28 00000023 722C                        jc disk_error
    29                                  
    30 00000025 BE[6E00]                    mov si, msg_pm
    31 00000028 E81A00                      call print16
    32                                  
    33 0000002B E492                        in al, 0x92
    34 0000002D 0C02                        or al, 2
    35 0000002F E692                        out 0x92, al
    36                                  
    37 00000031 0F0116[A900]                lgdt [gdt_ptr]
    38                                  
    39 00000036 0F20C0                      mov eax, cr0
    40 00000039 6683C801                    or eax, 1
    41 0000003D 0F22C0                      mov cr0, eax
    42                                  
    43 00000040 EA[AF00]0800                jmp 0x08:pm_entry
    44                                  
    45                                  print16:
    46 00000045 AC                          lodsb
    47 00000046 84C0                        test al, al
    48 00000048 7406                        jz .ret
    49 0000004A B40E                        mov ah, 0x0E
    50 0000004C CD10                        int 0x10
    51 0000004E EBF5                        jmp print16
    52                                  .ret:
    53 00000050 C3                          ret
    54                                  
    55                                  disk_error:
    56 00000051 BE[8300]                    mov si, msg_err
    57 00000054 E8EEFF                      call print16
    58                                  .halt:
    59 00000057 F4                          hlt
    60 00000058 EBFD                        jmp .halt
    61                                  
    62 0000005A 4C6F6164696E67206B-     msg_load: db "Loading kernel...", 13, 10, 0
    62 00000063 65726E656C2E2E2E0D-
    62 0000006C 0A00               
    63 0000006E 537769746368696E67-     msg_pm:   db "Switching to PM...", 13, 10, 0
    63 00000077 20746F20504D2E2E2E-
    63 00000080 0D0A00             
    64 00000083 4469736B206572726F-     msg_err:  db "Disk error!", 13, 10, 0
    64 0000008C 72210D0A00         
    65                                  
    66                                  gdt:
    67 00000091 0000000000000000            dq 0
    68                                  .code:
    69 00000099 FFFF0000                    dw 0xFFFF, 0
    70 0000009D 009ACF00                    db 0, 0x9A, 0xCF, 0
    71                                  .data:
    72 000000A1 FFFF0000                    dw 0xFFFF, 0
    73 000000A5 0092CF00                    db 0, 0x92, 0xCF, 0
    74                                  .end:
    75                                  
    76                                  gdt_ptr:
    77 000000A9 1700                        dw gdt.end - gdt - 1
    78 000000AB [91000000]                  dd gdt
    79                                  
    80                                  ; ============== 32位保护模式 ==============
    81                                  [BITS 32]
    82                                  pm_entry:
    83                                      ; 设置数据段
    84 000000AF 66B81000                    mov ax, 0x10
    85 000000B3 8ED8                        mov ds, ax
    86 000000B5 8EC0                        mov es, ax
    87 000000B7 8ED0                        mov ss, ax
    88 000000B9 BC00000900                  mov esp, 0x90000
    89                                  
    90                                      ; 跳转到内核
    91 000000BE E9(007E0000)                jmp KERNEL_START
    92                                  
    93                                  .halt:
    94 000000C3 F4                          hlt
    95 000000C4 EBFD                        jmp .halt
    96                                  
    97 000000C6 00<rep 138h>            times 510 - ($ - $$) db 0
    98 000001FE 55AA                    dw 0xAA55
